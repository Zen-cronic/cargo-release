{
  "name": "cargo-release-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3024",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3024",
    "check": "tsc --noEmit",
    "smoke:route": "node scripts/smoke.mjs",
    "smoke:relay": "node scripts/smoke-relay.mjs",
    "capture:visual": "node scripts/capture.mjs",
    "record:continuous": "node scripts/record-continuous-demo.mjs",
    "record:continuous:v3": "node scripts/record-continuous-demo-v3.mjs",
    "record:continuous:v4": "CARGO_RELEASE_DEMO_EDITION=v4 RECORDING_OUTPUT=../.playwright-mcp/continuous-demo-alex-v4 RECORDING_STEM=cargo-release-expanded-v4-source node scripts/record-continuous-demo-v3.mjs",
    "record:continuous:v5": "CARGO_RELEASE_DEMO_EDITION=v5 RECORDING_OUTPUT=../.playwright-mcp/continuous-demo-alex-v5 RECORDING_STEM=cargo-release-services-v5-source node scripts/record-continuous-demo-v3.mjs",
    "record:continuous:v6": "CARGO_RELEASE_DEMO_EDITION=v6 RECORDING_OUTPUT=../.playwright-mcp/continuous-demo-alex-v6 RECORDING_STEM=cargo-release-cloud-proof-v6-source node scripts/record-continuous-demo-v3.mjs",
    "prepare:slack-recording": "node scripts/open-slack-recording-profile.mjs",
    "rehearse:production": "node scripts/rehearse-production.mjs",
    "test:relay": "node --test tests/relay-policy.test.ts",
    "test:metrics": "node --test tests/mission-metrics.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "google-auth-library": "^11.0.2",
    "lucide-react": "1.33.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "7.0.2"
  }
}
